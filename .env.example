APP_NAME=Isir
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# GitHub API (optional - increases rate limit from 60 to 5000 req/hr)
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=

# AI provider keys (optional - enable AI summaries)
# Configure default provider in config/ai.php (`default` key).
# Set AI_MODEL to override the provider's default text model.
AI_DEFAULT_PROVIDER=openai
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
